# 이 파일을 .env 로 복사해서 값을 채우세요 (.env 는 git 에 올리지 않음, chmod 600 권장)
DRY_RUN=1
# bot_v5: 봇이 운용할 원화 (주석은 반드시 별도 줄에 — systemd 는 줄 끝 주석을 값으로 읽음)
BOT_CAPITAL=1000000
UPBIT_ACCESS=
UPBIT_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# 봇이 멈추면 알려주는 외부 감시용 핑 주소 (healthchecks.io 무료, 설정법은 deploy/README.md)
HEALTHCHECK_URL=
